# copy to .env and fill in. Scripts read these from the environment.
OPENAI_API_KEY=sk-...          # optional: direct Platform image API mode only
OPENROUTER_API_KEY=sk-or-...   # cheap copy routing (Kimi/DeepSeek/GLM)
ANTHROPIC_API_KEY=sk-ant-...   # premium analysis / fallback
DASHBOARD_IMAGE_PROVIDER=codex_local  # built-in Codex queue; no Platform key
OPENAI_IMAGE_MODEL=gpt-image-1

# Generic synchronous image API adapter. Use this only when the provider accepts
# prompt/width/height JSON and returns image bytes, b64, b64_json, or an image URL.
# Reference edits require the separate edit endpoint.
IMAGE_API_URL=
IMAGE_API_EDIT_URL=
IMAGE_API_KEY=
IMAGE_API_MODEL=

# HeyGen talking-head generation. Remote MCP/OAuth uses subscription credits and
# is connected to Codex separately. These vars enable the direct API-wallet path.
HEYGEN_API_KEY=...
HEYGEN_VOICE_ID=...

# Vendor-neutral carousel publishing. Leave disabled until an audited vendor is
# selected and Checkpoints B/C are explicitly approved in distribution_accounts.yaml.
POSTING_VENDOR_API_URL=
POSTING_VENDOR_API_KEY=
GLOSKIN_TIKTOK_FLAGSHIP_VENDOR_ACCOUNT_REF=
GLOSKIN_TIKTOK_VOLUME_01_VENDOR_ACCOUNT_REF=
GLOSKIN_INSTAGRAM_FLAGSHIP_VENDOR_ACCOUNT_REF=
VENDRARX_TIKTOK_FLAGSHIP_VENDOR_ACCOUNT_REF=
VENDRARX_INSTAGRAM_FLAGSHIP_VENDOR_ACCOUNT_REF=

# Deferred native publishing / future metrics adapters.
TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...
TIKTOK_ACCESS_TOKEN=...
META_ACCESS_TOKEN=...
IG_USER_ID=...
FB_PAGE_ID=...
META_AD_ACCOUNT_ID=...
ATTRIBUTION_API_KEY=...
